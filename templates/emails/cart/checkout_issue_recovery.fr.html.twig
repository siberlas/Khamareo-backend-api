{% extends 'emails/layout/base.html.twig' %}

{% block subject %}Le règlement de votre commande n'a pas abouti{% endblock %}

{% block content %}
    <p>{{ greeting }},</p>

    <p>Nous avons constaté que le règlement de votre commande n'a pas abouti. <strong>Rassurez-vous, votre compte n'a pas été débité.</strong></p>

    <p>Vos articles sont toujours dans votre panier, nous les mettons de côté pour vous :</p>

    {% if cart.items is not empty %}
    <div class="card">
        <table>
            <tbody>
                {% for item in cart.items %}
                {% set outOfStock = not item.product or item.product.stock <= 0 %}
                <tr style="border-bottom: 1px solid #E8DFD3;">
                    <td style="padding: 10px 8px 10px 0;">
                        <strong>{{ item.product ? item.product.name : 'Produit' }}</strong>
                        <br><span class="muted">Qté : {{ item.quantity }}</span>
                        {% if outOfStock %}
                        <br><span style="color: #B3261E; font-size: 12px; font-weight: 600;">Ce produit n'est plus disponible</span>
                        {% endif %}
                    </td>
                    <td style="padding: 10px 0; text-align: right; font-weight: 600; color: #D8A35D; white-space: nowrap;">
                        {{ (item.quantity * item.unitPrice)|format_currency('EUR', locale='fr') }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="divider"></div>
        <table>
            <tr>
                <td style="padding: 4px 0; color: #7A5C47; text-align: right;">Sous-total</td>
                <td style="padding: 4px 0; text-align: right; font-weight: 600; white-space: nowrap; padding-left: 16px;">{{ cart.subtotal|format_currency('EUR', locale='fr') }}</td>
            </tr>
        </table>
    </div>
    {% endif %}

    <div class="btn-wrapper">
        <a href="{{ checkoutUrl }}" class="btn-primary">Réessayer le paiement</a>
    </div>

    <p class="muted">Vos informations de livraison sont déjà enregistrées — il ne vous reste plus qu'à réessayer de régler votre commande.</p>

    <p class="muted">
        Une question ou un doute ? Notre équipe est joignable à
        <a href="mailto:akwaaba@khamareo.com">akwaaba@khamareo.com</a>
        ou <a href="https://wa.me/33613627010?text={{ 'Bonjour, j\'ai une question concernant ma commande.'|url_encode }}">envoyez-nous un message sur WhatsApp</a>.
    </p>

    <p>À très bientôt,<br>L'équipe Khamareo</p>
{% endblock %}
