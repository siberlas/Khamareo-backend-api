{% extends 'emails/layout/base.html.twig' %}

{% block subject %}Payment for your order didn't go through{% endblock %}

{% block content %}
    <p>{{ greeting }},</p>

    <p>We noticed that payment for your order didn't go through. <strong>Rest assured, your account has not been charged.</strong></p>

    <p>Your items are still in your cart — we're setting them aside for you:</p>

    {% if cart.items is not empty %}
    <div class="card">
        <table>
            <tbody>
                {% for item in cart.items %}
                {% set outOfStock = not item.product or item.product.stock <= 0 %}
                <tr style="border-bottom: 1px solid #E8DFD3;">
                    <td style="padding: 10px 8px 10px 0;">
                        <strong>{{ item.product ? item.product.name : 'Product' }}</strong>
                        <br><span class="muted">Qty: {{ item.quantity }}</span>
                        {% if outOfStock %}
                        <br><span style="color: #B3261E; font-size: 12px; font-weight: 600;">This product is no longer available</span>
                        {% endif %}
                    </td>
                    <td style="padding: 10px 0; text-align: right; font-weight: 600; color: #D8A35D; white-space: nowrap;">
                        {{ (item.quantity * item.unitPrice)|format_currency('EUR', locale='en') }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="divider"></div>
        <table>
            <tr>
                <td style="padding: 4px 0; color: #7A5C47; text-align: right;">Subtotal</td>
                <td style="padding: 4px 0; text-align: right; font-weight: 600; white-space: nowrap; padding-left: 16px;">{{ cart.subtotal|format_currency('EUR', locale='en') }}</td>
            </tr>
        </table>
    </div>
    {% endif %}

    <div class="btn-wrapper">
        <a href="{{ checkoutUrl }}" class="btn-primary">Try payment again</a>
    </div>

    <p class="muted">Your delivery details are already saved — all you need to do is try paying again.</p>

    <p class="muted">
        Any question or doubt? Our team is reachable at
        <a href="mailto:akwaaba@khamareo.com">akwaaba@khamareo.com</a>
        or <a href="https://wa.me/33613627010?text={{ 'Hello, I have a question about my order.'|url_encode }}">send us a message on WhatsApp</a>.
    </p>

    <p>See you soon,<br>The Khamareo team</p>
{% endblock %}
